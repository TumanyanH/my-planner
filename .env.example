# Copy to .env (./run.sh does this for you).

# Google sign-in (the default). Create an OAuth client of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add your site's address (for example
# https://92-5-32-249.sslip.io) under "Authorized JavaScript origins". See README.md.
GOOGLE_CLIENT_ID=
# Google accounts allowed to sign in, comma separated. Each account gets its own private tasks
# and activity log. Removing an address locks that account out immediately.
ALLOWED_EMAILS=

# Your timezone (IANA name, e.g. Europe/Berlin). Used for "tomorrow" and for repeating tasks.
TZ=UTC

# Port the app listens on.
PORT=8080

# Docker only: which address the port is published on. 127.0.0.1 = this machine only.
# Use 0.0.0.0 only if something else in front provides HTTPS.
BIND=127.0.0.1

# ./run.sh https only: the domain name that points at this server.
DOMAIN=
